# ──────────────────────────────────────────────
# SISA — variables del API
#
# Copia este archivo como .env y ajusta los valores. NO subas el .env al
# repositorio (ya esta en .gitignore); este archivo si se versiona y es la
# referencia para los tres ambientes.
#
# El .env cumple dos funciones a la vez:
#   1. Docker Compose lo lee para resolver los ${...} del docker-compose.yml.
#   2. Compose lo inyecta como env_file en el contenedor del API, de modo que
#      Spring Boot recibe cada variable tal cual esta escrita aqui.
#
# El compose NO tiene valores por omision: si falta una variable de esta
# lista, `docker compose up` falla diciendo cual falta. Es a proposito, para
# que un .env incompleto no arranque un contenedor con un valor inventado.
#
# Por eso las variables del correo van con guion bajo y no con punto: como
# variable de entorno, "spring.mail.host" no se resuelve con nada, pero
# SPRING_MAIL_HOST si.
# ──────────────────────────────────────────────

# ── Que archivo de configuracion es este ──────────────────────────────
# El compose lo usa para saber que archivo inyectar en el contenedor.
# En los servidores, pon aqui mismo el nombre del archivo de ese ambiente
# (por ejemplo SISA_ENV_FILE=.env.testdti) y se carga solo.
SISA_ENV_FILE=.env

# ── Red de Docker ─────────────────────────────────────────────────────
# false = el compose crea la red. true = la red ya existe porque el reverse
# proxy vive ahi, y en ese caso el nombre tiene que ser el de esa red.
#   local    → sisa-api-net     / false
#   testdti  → net-cds-test     / true
#   prod     → sisava-network   / true
DOCKER_NETWORK=sisa-api-net
DOCKER_NETWORK_EXTERNAL=false

# ── Puertos publicados en el host ─────────────────────────────────────
# 127.0.0.1 = solo accesible desde el propio servidor. Si el reverse proxy
# es un contenedor que entra por host.docker.internal, API_BIND tiene que ser
# 0.0.0.0: host.docker.internal resuelve a la IP del bridge de Docker, no a
# 127.0.0.1. La BD no pasa por el proxy y se queda en 127.0.0.1.
#
# DB_PORT es el puerto en el HOST, no el del contenedor (dentro siempre es
# 3306). Si tu maquina ya tiene un MySQL instalado, el 3306 esta ocupado y el
# compose no arranca con "ports are not available": en local usa otro, por
# ejemplo 3307. En los servidores no suele haber MySQL y 3306 esta libre.
API_BIND=127.0.0.1
API_PORT=8080
DB_BIND=127.0.0.1
DB_PORT=3307

# ── Ruta base del API ─────────────────────────────────────────────────
# Prefijo de todas las rutas (server.servlet.context-path). Tiene que
# coincidir con VITE_API_URL del front:
#
#   local      → (vacio)      el API responde en la raiz:
#                             http://localhost:8080/auth/login
#   servidores → /sga-api     detras del proxy:
#                             https://cds.utez.edu.mx/sga-api/auth/login
#
# El prefijo es distinto del /SGA del front (https://cds.utez.edu.mx/SGA/login)
# para que el reverse proxy sepa a quien mandar cada peticion del mismo
# dominio. Reglas del proxy (el prefijo NO se quita: el back lo espera):
#   location /sga-api/ { proxy_pass http://host.docker.internal:11118; }  # API
#   location /SGA/     { proxy_pass http://host:puerto/; }                # front (a este si se le quita /SGA)
SISA_CONTEXT_PATH=

# ── Base de datos (contenedor db-sisa) ────────────────────────────────
# La BD del compose NO usa DB_USERNAME/DB_PASSWORD de mas abajo: MySQL no
# permite crear un usuario llamado root, asi que el usuario de la aplicacion
# tiene su propio par de credenciales.
DB_NAME=sisa
DB_APP_USER=sisa
DB_APP_PASSWORD=cambia-esta-clave
DB_ROOT_PASSWORD=cambia-esta-clave
# Con nombre explicito para que dos ambientes en la MISMA maquina no
# compartan la misma base. En los servidores da igual, pero en local,
# levantarte con .env.testdti no debe pisarte la base de desarrollo.
DB_VOLUME_NAME=vol-db-sisa

# ── Base de datos (Spring Boot) ───────────────────────────────────────
# Cuando corres el jar o `mvn spring-boot:run` directo en tu maquina, estas
# son las que usa la aplicacion y apuntan a tu MySQL local. Dentro de Docker
# el compose sobrescribe DB_URL/DB_USERNAME/DB_PASSWORD para que apunten al
# servicio db-sisa, asi que aqui puede quedar como esta.
DB_URL=jdbc:mysql://localhost:3306/sisa?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=root
DB_DDL_AUTO=update
DB_SHOW_SQL=false
DB_FORMAT_SQL=false

# ── Seguridad ─────────────────────────────────────────────────────────
# Sin valor por omision a proposito: la app arranca con un secreto de
# desarrollo, asi que revisa que este definido en testdti y prod.
JWT_SECRET=cambia-este-secreto-por-uno-de-produccion
# Origenes que el navegador puede usar para llamar al API. En testdti y prod
# es el origen publico del front, no localhost. Un origen no lleva ruta:
# https://cds.utez.edu.mx, nunca https://cds.utez.edu.mx/SGA.
SISA_CORS_ALLOWED_ORIGINS=http://localhost:5173
# Base publica del front, CON la ruta base si el proxy lo sirve bajo una
# (https://cds.utez.edu.mx/SGA), sin "/" final. Se usa en los enlaces de los
# correos y como prefijo de las rutas de retorno del pago en linea.
SISA_FRONTEND_BASE_URL=http://localhost:5173
# Clave compartida de las cuentas de prueba (admin, servicios escolares,
# finanzas, director). Vacio = no se crea ninguna cuenta de prueba.
SISA_TEST_PASSWORD=

# ── Correo (SMTP) ─────────────────────────────────────────────────────
# Puerto 465 usa SSL implicito y va con SSL_ENABLE=true y STARTTLS_ENABLE=false.
# Si tu servidor usa el 587 (STARTTLS), pon PORT=587, SSL_ENABLE=false y
# STARTTLS_ENABLE=true: no se pueden usar los dos a la vez.
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=465
SPRING_MAIL_USERNAME=cuenta-de-correo@utez.edu.mx
SPRING_MAIL_PASSWORD=la-contrasena-de-aplicacion
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_SSL_ENABLE=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=false
# true = si el correo falla, la peticion que lo dispara tambien falla.
SISA_MAIL_FAIL_FAST=false

# ── EvoPayments (Mastercard, pago en linea) ───────────────────────────
# Faltantes = la app arranca igual y el checkout responde 502 con mensaje
# claro. En TEST el merchant es el de sandbox (TESTUTEZ).
EVO_BASE_URL=
EVO_MERCHANT_ID=
EVO_API_USERNAME=
EVO_API_PASSWORD=
EVO_CHECKOUT_JS_URL=
# A donde vuelve el navegador tras el pago. En testdti/prod, la URL publica
# con la ruta base: https://cds.utez.edu.mx/SGA/portal/registro/ficha
EVO_RETURN_URL=http://localhost:5173/portal/registro/ficha
EVO_CANCEL_URL=http://localhost:5173/portal/registro/ficha
EVO_MERCHANT_NAME=UTEZ
EVO_ORDER_ID_PREFIX=
# Maximo que acepta el gateway: 40.
EVO_ORDER_ID_LENGTH=40
EVO_CURRENCY=MXN

# ── Admision ──────────────────────────────────────────────────────────
SISA_FICHA_AMOUNT=500.00
# Fechas de admision y de pago se guardan en UTC pero se leen como hora
# local de Mexico. Sin esto, un servidor en UTC resolveria "abre 01/09
# 00:00" a 31/08 y avisaria un dia temprano.
SISA_ADMISSION_ZONE=America/Mexico_City

# ── Limites de recursos de los contenedores ──────────────────────────
# La imagen trae un JAVA_OPTS por omision sensato; si lo defines aqui, este
# gana (el compose lo inyecta despues de la imagen).
#JAVA_OPTS=-XX:MaxRAMPercentage=70 -XX:+ExitOnOutOfMemoryError
DB_CPUS_LIMIT=1.0
DB_MEMORY_LIMIT=1G
BACKEND_CPUS_LIMIT=1.0
BACKEND_MEMORY_LIMIT=768M
